{
  "name": "waraq-notes",
  "version": "1.0.0",
  "description": "وِرَاق — Arabic-first, lightweight local-first knowledge base built with Electron",
  "main": "main.js",
  "author": "Waraq Community",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.waraq.notes",
    "productName": "وِرَاق",
    "directories": { "buildResources": "assets", "output": "release" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "renderer.js", "assets/**/*", "package.json"],
    "asar": true,
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "linux": { "target": ["AppImage", "deb"], "icon": "assets/icon.png", "category": "Office" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
